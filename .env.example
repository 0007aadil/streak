# Neon Postgres — pooled URL for runtime queries (serverless-friendly)
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:pass@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Neon Postgres — direct URL used by `prisma db push` / migrations
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL="postgresql://user:pass@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# 48+ random bytes, hex-encoded. Generate locally:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-long-random-value-at-least-32-chars"
